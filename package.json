{
  "name": "ludwig-snippets",
  "displayName": "Ludwig Snippets",
  "description": "Snippets for every section of a Ludwig config: features, encoders, decoders, combiners, losses, preprocessing, trainer, hyperopt and LLM fine-tuning. Generated from Ludwig's own schema.",
  "repository": {
    "type": "git",
    "url": "https://github.com/mhabedank/ludwig-snippets"
  },
  "bugs": {
    "url": "https://github.com/mhabedank/ludwig-snippets/issues"
  },
  "version": "0.3.0",
  "engines": {
    "vscode": "^1.91.0"
  },
  "icon": "images/ludwig_icon.png",
  "publisher": "MartinHabedank",
  "license": "Apache-2.0",
  "categories": [
    "Snippets",
    "AI",
    "Machine Learning",
    "Data Science"
  ],
  "keywords": [
    "ludwig",
    "yaml",
    "machine learning",
    "deep learning",
    "automl",
    "llm",
    "fine-tuning"
  ],
  "ludwig": {
    "generatedFrom": "0.17.8"
  },
  "scripts": {
    "generate": "node tools/generate-snippets.mjs",
    "test": "node tools/validate-snippets.mjs",
    "check": "node tools/generate-snippets.mjs --check && node tools/validate-snippets.mjs"
  },
  "devDependencies": {
    "yaml": "^2.8.1"
  },
